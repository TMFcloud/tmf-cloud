# -------------------------------------------------------------
# THE MINING FUTURE (TMF) CLOUD PLATFORM - ENVIRONMENT SECRETS
# -------------------------------------------------------------

# Site Domains
NEXT_PUBLIC_SITE_URL=https://cloud.theminingfuture.com
NEXT_PUBLIC_WORDPRESS_URL=https://www.theminingfuture.com

# Supabase Credentials (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# NOWPayments Gateway (from NOWPayments Account Settings)
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
NOWPAYMENTS_SANDBOX=false

# Segments Equalizer Hashrate Layer (Read-Only API)
SEGMENTS_EQUALIZER_API_KEY=your-segments-read-only-api-key
SEGMENTS_EQUALIZER_BASE_URL=https://api.segmentsequalizer.com/v1

# Admin Operational Alerts (Telegram Instant Notifications for Manual Allocation)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Resend Transactional Email (Optional for Pilot)
RESEND_API_KEY=
EMAIL_FROM="The Mining Future <no-reply@theminingfuture.com>"
